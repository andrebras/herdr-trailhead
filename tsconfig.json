{
  "// why": "Type-checks the modules that know nothing about Herdr, so it runs everywhere, GitHub's CI included. main.js needs the type files Herdr writes into its own folder, so tsconfig.herdr.json checks it where Herdr is installed (bin/typecheck-herdr).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true
  },
  "files": [
    "mods/trailhead/paths.js",
    "mods/trailhead/match.js",
    "mods/trailhead/kept.js",
    "mods/trailhead/settings.js",
    "mods/trailhead/actions.js",
    "mods/trailhead/remote.js",
    "mods/trailhead/keys.js",
    "mods/trailhead/spaces.js",
    "mods/trailhead/discover.js",
    "mods/trailhead/recent.js",
    "mods/trailhead/filter.js"
  ]
}
